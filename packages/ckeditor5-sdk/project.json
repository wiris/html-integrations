{
    "name": "ck5",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "targets": {
        "build": {
            "executor": "nx:run-script",
            "options": {
                "script": "build"
            }
        },
        "lint": {
            "executor": "@nx/linter:eslint",
            "options": {
                "eslintConfig": "./.eslintrc.js",
                "lintFilePatterns": ["src/**/*.{ts,tsx,js,jsx}"]
            },
            "outputs": ["{options.outputFile}"]
        }
    }
}